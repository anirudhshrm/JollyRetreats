# Frontend Environment Variables Example

# API Configuration
# Port number for the backend server (default: 4000)
VITE_API_PORT=4000

# Optional: Full API base URL (overrides VITE_API_PORT if set)
# Example: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Stripe Configuration
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Firebase Login (optional)
# Set VITE_FIREBASE_AUTH_ENABLED=true after creating a Firebase Web app
# and enabling Email/Password sign-in in Firebase Authentication.
VITE_FIREBASE_AUTH_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
